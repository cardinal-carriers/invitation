rules_version = '2';

/* ==========================================================================
   This file IS the access model. There is nothing else protecting the data.

   Paste it into Firebase Console → Firestore → Rules → Publish, and keep this
   copy in step with what is deployed. Verify with the Rules Playground and
   the curl checks in docs/mvp-plan.md §5.6 before sharing the link.

   Create the database in PRODUCTION mode. Test mode opens every document to
   the world for 30 days.

   Two kinds of signed-in person:

     the owner    events/shower.hostUid — one uid. Edits the invitation,
                  publishes it, deletes replies.
     a watcher    access/shower.hostEmails — a list of addresses. Reads the
                  replies as they arrive and nothing else.

   The list lives in access/shower and NOT on the event. events/shower is
   world-readable the moment it is published — that is what makes it an
   invitation — so an address stored there is an address published to
   everyone holding the link. Nobody reads access/shower directly; the rules
   below reach it with get(), which is not itself subject to these rules.

   A watcher is matched on email rather than uid on purpose: it means the
   owner can add someone before that person has ever signed in, and they get
   access by signing in normally. Matching on uid would need the owner to
   chase down a uid from the console, which is exactly the errand this is
   meant to avoid.
   ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    function event() {
      return get(/databases/$(database)/documents/events/shower).data;
    }
    function accessData() {
      return get(/databases/$(database)/documents/access/shower).data;
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == event().hostUid;
    }

    /* Email-link sign-in verifies the address by construction, so
       email_verified is already true for every account this app makes. The
       check is written out anyway: if a password provider is ever switched
       on, an unverified address must not inherit access by claiming someone
       else's email. Presence of hostEmails is tested before it is read,
       because reading a field that isn't there aborts the whole rule. */
    function isWatcher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/access/shower)
        && 'hostEmails' in accessData()
        && accessData().hostEmails is list
        && request.auth.token.email.lower() in accessData().hostEmails;
    }

    function canSeeReplies() { return isOwner() || isWatcher(); }

    match /events/{eventId} {
      // Anyone may read a published invitation. That is the invitation itself.
      allow read: if resource.data.published == true || canSeeReplies();

      // Only the owner may edit, and may not hand the event to someone else.
      // A watcher is deliberately not included: they watch, they do not edit.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.hostUid
                    && request.resource.data.hostUid == resource.data.hostUid;

      // There is exactly one event and it is created by hand in the console.
      allow create, delete: if false;
    }

    /* The watcher list. Only the owner reads or writes it — a watcher has no
       need to see who else is watching, and a guest has no business seeing
       any of it. exists() is checked before the document is read, because
       reading a document that isn't there aborts the whole rule. */
    match /access/{docId} {
      allow read, write: if isOwner();
    }

    match /rsvps/{rsvpId} {
      // Anyone may reply to a published invitation, with a well-formed document.
      allow create: if event().published == true
        && request.resource.data.keys().hasOnly(
             ['eventId','name','others','attending','note','createdAt'])
        && request.resource.data.eventId == 'shower'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.others is list
        && request.resource.data.others.size() <= 10
        && request.resource.data.attending is bool
        && (request.resource.data.note == null ||
            (request.resource.data.note is string &&
             request.resource.data.note.size() <= 500))
        && request.resource.data.createdAt is timestamp;

      // The owner and anyone on hostEmails. Guests never see each other.
      allow read: if canSeeReplies();

      // Deleting someone's reply is the owner's call alone.
      allow delete: if isOwner();

      // Nobody edits a reply, including its author.
      allow update: if false;
    }
  }
}
